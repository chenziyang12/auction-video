{
  "name": "auction-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx src/web/server.ts",
    "start": "tsx src/web/server.ts",
    "build": "npm run render",
    "typecheck": "tsc --noEmit",
    "render": "tsx scripts/renderDemo.ts",
    "fetch:jd": "tsx scripts/prepareJdDemo.ts",
    "render:jd": "tsx scripts/renderJd.ts",
    "voice:demo": "tsx scripts/prepareVoice.ts demo",
    "voice:jd": "tsx scripts/prepareVoice.ts jd",
    "render:voice": "npm run voice:demo && tsx scripts/renderVoice.ts demo",
    "render:jd:voice": "npm run voice:jd && tsx scripts/renderVoice.ts jd",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.8.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/media": "^4.0.0",
    "express": "^5.2.1",
    "mediabunny": "^1.55.1",
    "playwright": "^1.55.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.1.7"
  }
}
